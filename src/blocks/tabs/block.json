{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axiom-blocks/tabs",
  "version": "1.0.0",
  "title": "Tabs",
  "category": "axiom-blocks",
  "description": "Horizontal tabs with any block content inside each panel.",
  "keywords": ["tabs", "tab", "content", "panel"],
  "textdomain": "axiom-blocks",
  "icon": "index-card",
  "attributes": {
    "activeTab":              { "type": "string", "default": "" },
    "tabOrientation":         { "type": "string", "default": "horizontal" },
    "tabAlignment":           { "type": "string", "default": "left" },
    "fullWidthTabs":          { "type": "boolean", "default": false },
    "barFitContent":          { "type": "boolean", "default": false },

    "tabStyle":               { "type": "string", "default": "" },

    "activeColor":            { "type": "string", "default": "" },
    "inactiveColor":          { "type": "string", "default": "" },
    "backgroundColor":        { "type": "string", "default": "" },
    "contentBackgroundColor": { "type": "string", "default": "" },
    "contentGap":             { "type": "number", "default": 0 },

    "labelFontFamily":     { "type": "string", "default": "" },
    "labelFontWeight":     { "type": "string", "default": "" },
    "labelFontSize":       { "type": "string", "default": "" },
    "labelLineHeight":     { "type": "string", "default": "" },
    "labelLetterSpacing":  { "type": "string", "default": "" },
    "labelTextTransform":  { "type": "string", "default": "" },
    "labelTextDecoration": { "type": "string", "default": "" },
    "labelTextAlign":      { "type": "string", "default": "" },

    "tabGap":                { "type": "string", "default": "" },
    "tabIconGap":            { "type": "string", "default": "" },
    "tabBg":                 { "type": "string", "default": "" },
    "tabBgHover":            { "type": "string", "default": "" },
    "tabBgActive":           { "type": "string", "default": "" },
    "tabColorHover":         { "type": "string", "default": "" },
    "tabBorderTopWidth":     { "type": "string", "default": "" },
    "tabBorderRightWidth":   { "type": "string", "default": "" },
    "tabBorderBottomWidth":  { "type": "string", "default": "" },
    "tabBorderLeftWidth":    { "type": "string", "default": "" },
    "tabBorderStyle":        { "type": "string", "default": "" },
    "tabBorderColor":        { "type": "string", "default": "" },
    "tabRadiusTopLeft":      { "type": "string", "default": "" },
    "tabRadiusTopRight":     { "type": "string", "default": "" },
    "tabRadiusBottomRight":  { "type": "string", "default": "" },
    "tabRadiusBottomLeft":   { "type": "string", "default": "" },

    "tabPaddingTop":    { "type": "string", "default": "" },
    "tabPaddingRight":  { "type": "string", "default": "" },
    "tabPaddingBottom": { "type": "string", "default": "" },
    "tabPaddingLeft":   { "type": "string", "default": "" },

    "tabShadow":       { "type": "string", "default": "" },
    "tabShadowHover":  { "type": "string", "default": "" },
    "tabShadowActive": { "type": "string", "default": "" },

    "tabBorderTopWidthHover":     { "type": "string", "default": "" },
    "tabBorderRightWidthHover":   { "type": "string", "default": "" },
    "tabBorderBottomWidthHover":  { "type": "string", "default": "" },
    "tabBorderLeftWidthHover":    { "type": "string", "default": "" },
    "tabBorderStyleHover":        { "type": "string", "default": "" },
    "tabBorderColorHover":        { "type": "string", "default": "" },
    "tabBorderTopWidthActive":    { "type": "string", "default": "" },
    "tabBorderRightWidthActive":  { "type": "string", "default": "" },
    "tabBorderBottomWidthActive": { "type": "string", "default": "" },
    "tabBorderLeftWidthActive":   { "type": "string", "default": "" },
    "tabBorderStyleActive":       { "type": "string", "default": "" },
    "tabBorderColorActive":       { "type": "string", "default": "" },

    "barBgType":            { "type": "string", "default": "" },
    "barBgGradType":        { "type": "string", "default": "linear" },
    "barBgGradAngle":       { "type": "number", "default": 90 },
    "barBgGradStops":       { "type": "array",  "default": [] },
    "barBorderTopWidth":    { "type": "string", "default": "" },
    "barBorderRightWidth":  { "type": "string", "default": "" },
    "barBorderBottomWidth": { "type": "string", "default": "" },
    "barBorderLeftWidth":   { "type": "string", "default": "" },
    "barBorderStyle":       { "type": "string", "default": "" },
    "barBorderColor":       { "type": "string", "default": "" },
    "barRadiusTopLeft":     { "type": "string", "default": "" },
    "barRadiusTopRight":    { "type": "string", "default": "" },
    "barRadiusBottomRight": { "type": "string", "default": "" },
    "barRadiusBottomLeft":  { "type": "string", "default": "" },
    "barPaddingTop":        { "type": "string", "default": "" },
    "barPaddingRight":      { "type": "string", "default": "" },
    "barPaddingBottom":     { "type": "string", "default": "" },
    "barPaddingLeft":       { "type": "string", "default": "" },

    "panelBorderTopWidth":    { "type": "string", "default": "" },
    "panelBorderRightWidth":  { "type": "string", "default": "" },
    "panelBorderBottomWidth": { "type": "string", "default": "" },
    "panelBorderLeftWidth":   { "type": "string", "default": "" },
    "panelBorderStyle":       { "type": "string", "default": "" },
    "panelBorderColor":       { "type": "string", "default": "" },
    "panelRadiusTopLeft":     { "type": "string", "default": "" },
    "panelRadiusTopRight":    { "type": "string", "default": "" },
    "panelRadiusBottomRight": { "type": "string", "default": "" },
    "panelRadiusBottomLeft":  { "type": "string", "default": "" },
    "panelShadow":            { "type": "string", "default": "" },
    "panelPaddingTop":        { "type": "string", "default": "" },
    "panelPaddingRight":      { "type": "string", "default": "" },
    "panelPaddingBottom":     { "type": "string", "default": "" },
    "panelPaddingLeft":       { "type": "string", "default": "" },

    "panelBgType":            { "type": "string",  "default": "" },
    "panelBgGradType":        { "type": "string",  "default": "linear" },
    "panelBgGradAngle":       { "type": "number",  "default": 90 },
    "panelBgGradStops":       { "type": "array",   "default": [] },
    "panelBgImage":           { "type": "object",  "default": null },
    "panelBgImageSize":       { "type": "string",  "default": "cover" },
    "panelBgImagePosition":   { "type": "string",  "default": "center center" },
    "panelBgImageRepeat":     { "type": "string",  "default": "no-repeat" },
    "panelBgImageAttachment": { "type": "string",  "default": "scroll" },
    "panelBgParallax":        { "type": "boolean", "default": false },
    "panelBgParallaxSpeed":   { "type": "number",  "default": 30 },
    "panelBgOverlay":         { "type": "string",  "default": "" },
    "panelBgOverlayType":     { "type": "string",  "default": "color" },
    "panelBgOverlayGradType": { "type": "string",  "default": "linear" },
    "panelBgOverlayGradAngle":{ "type": "number",  "default": 180 },
    "panelBgOverlayGradFrom": { "type": "string",  "default": "#000000" },
    "panelBgOverlayGradTo":   { "type": "string",  "default": "rgba(0,0,0,0)" },
    "panelBgOverlayOpacity":  { "type": "number",  "default": 0 },
    "panelBgOverlayBlend":    { "type": "string",  "default": "normal" },

    "paddingTop":    { "type": "string", "default": "" },
    "paddingRight":  { "type": "string", "default": "" },
    "paddingBottom": { "type": "string", "default": "" },
    "paddingLeft":   { "type": "string", "default": "" },
    "marginTop":     { "type": "string", "default": "" },
    "marginRight":   { "type": "string", "default": "" },
    "marginBottom":  { "type": "string", "default": "" },
    "marginLeft":    { "type": "string", "default": "" }
  },
  "providesContext": {
    "axiom-blocks/activeTab": "activeTab"
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "viewScript": "file:./assets/tabs.js",
  "render": "file:./render.php"
}
