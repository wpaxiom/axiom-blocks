{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/post-card",
	"version": "1.0.0",
	"title": "Post Card",
	"category": "axiom-blocks",
	"description": "The card template repeated for every post in a Post Grid. Holds any blocks.",
	"textdomain": "axiom-blocks",
	"icon": "id-alt",
	"ancestor": ["axiom-blocks/post-grid"],
	"usesContext": ["postId", "postType", "axiom-blocks/postGridLayout"],
	"attributes": {
		"cardRole": { "type": "string", "default": "default" },

		"cardBg":      { "type": "string", "default": "" },
		"cardBgHover": { "type": "string", "default": "" },
		"cardBgType":          { "type": "string", "default": "" },
		"cardBgGradType":      { "type": "string", "default": "linear" },
		"cardBgGradAngle":     { "type": "number", "default": 90 },
		"cardBgGradStops":     { "type": "array",  "default": [] },
		"cardBgImage":         { "type": "object", "default": null },
		"cardBgImageSize":     { "type": "string", "default": "cover" },
		"cardBgImagePosition": { "type": "string", "default": "center center" },
		"cardBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"cardBgOverlay":       { "type": "string", "default": "" },
		"cardHoverBgType":          { "type": "string", "default": "" },
		"cardHoverBgGradType":      { "type": "string", "default": "linear" },
		"cardHoverBgGradAngle":     { "type": "number", "default": 90 },
		"cardHoverBgGradStops":     { "type": "array",  "default": [] },
		"cardHoverBgImage":         { "type": "object", "default": null },
		"cardHoverBgImageSize":     { "type": "string", "default": "cover" },
		"cardHoverBgImagePosition": { "type": "string", "default": "center center" },
		"cardHoverBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"cardHoverBgOverlay":       { "type": "string", "default": "" },

		"cardBorderTopWidth":    { "type": "string", "default": "" },
		"cardBorderRightWidth":  { "type": "string", "default": "" },
		"cardBorderBottomWidth": { "type": "string", "default": "" },
		"cardBorderLeftWidth":   { "type": "string", "default": "" },
		"cardBorderStyle":       { "type": "string", "default": "" },
		"cardBorderColor":       { "type": "string", "default": "" },
		"cardBorderColorHover":  { "type": "string", "default": "" },

		"cardRadiusTopLeft":     { "type": "string", "default": "" },
		"cardRadiusTopRight":    { "type": "string", "default": "" },
		"cardRadiusBottomRight": { "type": "string", "default": "" },
		"cardRadiusBottomLeft":  { "type": "string", "default": "" },

		"cardShadow":      { "type": "string", "default": "" },
		"cardShadowHover": { "type": "string", "default": "" },

		"cardMinHeight": { "type": "string", "default": "" },
		"cardGap":       { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render":       "file:./render.php"
}
