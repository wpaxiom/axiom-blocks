{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/accordion",
	"version": "1.0.0",
	"title": "Accordion",
	"category": "axiom-blocks",
	"description": "Collapsible panels for FAQs and disclosures — styled headers, icons, single-open control, and smooth animation on top of native details/summary.",
	"keywords": ["accordion", "faq", "toggle", "collapse", "details"],
	"textdomain": "axiom-blocks",
	"icon": "list-view",
	"attributes": {
		"closeOthers":   { "type": "boolean", "default": true },
		"firstItemOpen": { "type": "boolean", "default": true },
		"headingLevel":  { "type": "string",  "default": "h3" },
		"faqSchema":     { "type": "boolean", "default": false },

		"transitionDuration": { "type": "number",  "default": 300 },
		"showExpandAll":      { "type": "boolean", "default": false },
		"deepLink":           { "type": "boolean", "default": false },
		"collapseOnMobile":   { "type": "boolean", "default": false },

		"showIcon":     { "type": "boolean", "default": true },
		"iconSlug":     { "type": "string",  "default": "chevron-down" },
		"iconPosition": { "type": "string",  "default": "right" },
		"rotateIcon":   { "type": "boolean", "default": true },
		"iconColor":       { "type": "string",  "default": "" },
		"iconColorActive": { "type": "string",  "default": "" },
		"iconSize":        { "type": "string",  "default": "" },

		"containerShadow":  { "type": "string", "default": "" },
		"itemBg":           { "type": "string", "default": "" },
		"itemShadow":       { "type": "string", "default": "" },
		"itemBgHover":      { "type": "string", "default": "" },
		"itemShadowHover":  { "type": "string", "default": "" },

		"itemBgType":          { "type": "string", "default": "" },
		"itemBgGradType":      { "type": "string", "default": "linear" },
		"itemBgGradAngle":     { "type": "number", "default": 90 },
		"itemBgGradStops":     { "type": "array",  "default": [] },
		"itemBgImage":         { "type": "object", "default": null },
		"itemBgImageSize":     { "type": "string", "default": "cover" },
		"itemBgImagePosition": { "type": "string", "default": "center center" },
		"itemBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"itemBgOverlay":       { "type": "string", "default": "" },

		"itemHoverBgType":          { "type": "string", "default": "" },
		"itemHoverBgGradType":      { "type": "string", "default": "linear" },
		"itemHoverBgGradAngle":     { "type": "number", "default": 90 },
		"itemHoverBgGradStops":     { "type": "array",  "default": [] },
		"itemHoverBgImage":         { "type": "object", "default": null },
		"itemHoverBgImageSize":     { "type": "string", "default": "cover" },
		"itemHoverBgImagePosition": { "type": "string", "default": "center center" },
		"itemHoverBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"itemHoverBgOverlay":       { "type": "string", "default": "" },

		"bodyMaxWidth":     { "type": "string", "default": "" },

		"headerBg":           { "type": "string", "default": "" },
		"headerColor":        { "type": "string", "default": "" },
		"headerBgHover":      { "type": "string", "default": "" },
		"headerColorHover":   { "type": "string", "default": "" },
		"activeHeaderBg":     { "type": "string", "default": "" },
		"activeHeaderColor":  { "type": "string", "default": "" },

		"headerBgType":          { "type": "string", "default": "" },
		"headerBgGradType":      { "type": "string", "default": "linear" },
		"headerBgGradAngle":     { "type": "number", "default": 90 },
		"headerBgGradStops":     { "type": "array",  "default": [] },
		"headerBgImage":         { "type": "object", "default": null },
		"headerBgImageSize":     { "type": "string", "default": "cover" },
		"headerBgImagePosition": { "type": "string", "default": "center center" },
		"headerBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"headerBgOverlay":       { "type": "string", "default": "" },

		"headerHoverBgType":          { "type": "string", "default": "" },
		"headerHoverBgGradType":      { "type": "string", "default": "linear" },
		"headerHoverBgGradAngle":     { "type": "number", "default": 90 },
		"headerHoverBgGradStops":     { "type": "array",  "default": [] },
		"headerHoverBgImage":         { "type": "object", "default": null },
		"headerHoverBgImageSize":     { "type": "string", "default": "cover" },
		"headerHoverBgImagePosition": { "type": "string", "default": "center center" },
		"headerHoverBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"headerHoverBgOverlay":       { "type": "string", "default": "" },

		"headerActiveBgType":          { "type": "string", "default": "" },
		"headerActiveBgGradType":      { "type": "string", "default": "linear" },
		"headerActiveBgGradAngle":     { "type": "number", "default": 90 },
		"headerActiveBgGradStops":     { "type": "array",  "default": [] },
		"headerActiveBgImage":         { "type": "object", "default": null },
		"headerActiveBgImageSize":     { "type": "string", "default": "cover" },
		"headerActiveBgImagePosition": { "type": "string", "default": "center center" },
		"headerActiveBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"headerActiveBgOverlay":       { "type": "string", "default": "" },

		"headerPaddingTop":    { "type": "string", "default": "" },
		"headerPaddingRight":  { "type": "string", "default": "" },
		"headerPaddingBottom": { "type": "string", "default": "" },
		"headerPaddingLeft":   { "type": "string", "default": "" },

		"bodyBg":    { "type": "string", "default": "" },
		"bodyColor": { "type": "string", "default": "" },

		"bodyBgType":          { "type": "string", "default": "" },
		"bodyBgGradType":      { "type": "string", "default": "linear" },
		"bodyBgGradAngle":     { "type": "number", "default": 90 },
		"bodyBgGradStops":     { "type": "array",  "default": [] },
		"bodyBgImage":         { "type": "object", "default": null },
		"bodyBgImageSize":     { "type": "string", "default": "cover" },
		"bodyBgImagePosition": { "type": "string", "default": "center center" },
		"bodyBgImageRepeat":   { "type": "string", "default": "no-repeat" },
		"bodyBgOverlay":       { "type": "string", "default": "" },

		"bodyPaddingTop":    { "type": "string", "default": "" },
		"bodyPaddingRight":  { "type": "string", "default": "" },
		"bodyPaddingBottom": { "type": "string", "default": "" },
		"bodyPaddingLeft":   { "type": "string", "default": "" },

		"bodyBorderStyle":       { "type": "string", "default": "" },
		"bodyBorderColor":       { "type": "string", "default": "" },
		"bodyBorderTopWidth":    { "type": "string", "default": "" },
		"bodyBorderRightWidth":  { "type": "string", "default": "" },
		"bodyBorderBottomWidth": { "type": "string", "default": "" },
		"bodyBorderLeftWidth":   { "type": "string", "default": "" },
		"bodyRadiusTopLeft":     { "type": "string", "default": "" },
		"bodyRadiusTopRight":    { "type": "string", "default": "" },
		"bodyRadiusBottomRight": { "type": "string", "default": "" },
		"bodyRadiusBottomLeft":  { "type": "string", "default": "" },

		"borderColor":  { "type": "string", "default": "" },
		"borderWidth":  { "type": "string", "default": "" },
		"borderRadius": { "type": "string", "default": "" },
		"itemGap":      { "type": "string", "default": "" },

		"borderStyle":       { "type": "string", "default": "" },
		"borderTopWidth":    { "type": "string", "default": "" },
		"borderRightWidth":  { "type": "string", "default": "" },
		"borderBottomWidth": { "type": "string", "default": "" },
		"borderLeftWidth":   { "type": "string", "default": "" },
		"radiusTopLeft":     { "type": "string", "default": "" },
		"radiusTopRight":    { "type": "string", "default": "" },
		"radiusBottomRight": { "type": "string", "default": "" },
		"radiusBottomLeft":  { "type": "string", "default": "" },

		"containerBorderColor":  { "type": "string", "default": "" },
		"containerBorderWidth":  { "type": "string", "default": "" },
		"containerBorderRadius": { "type": "string", "default": "" },

		"containerBorderStyle":       { "type": "string", "default": "" },
		"containerBorderTopWidth":    { "type": "string", "default": "" },
		"containerBorderRightWidth":  { "type": "string", "default": "" },
		"containerBorderBottomWidth": { "type": "string", "default": "" },
		"containerBorderLeftWidth":   { "type": "string", "default": "" },
		"containerRadiusTopLeft":     { "type": "string", "default": "" },
		"containerRadiusTopRight":    { "type": "string", "default": "" },
		"containerRadiusBottomRight": { "type": "string", "default": "" },
		"containerRadiusBottomLeft":  { "type": "string", "default": "" },

		"headerFontFamily":     { "type": "string", "default": "" },
		"headerFontWeight":     { "type": "string", "default": "" },
		"headerFontSize":       { "type": "string", "default": "" },
		"headerLineHeight":     { "type": "string", "default": "" },
		"headerLetterSpacing":  { "type": "string", "default": "" },
		"headerTextTransform":  { "type": "string", "default": "" },
		"headerTextDecoration": { "type": "string", "default": "" },
		"headerTextAlign":      { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" }
	},
	"providesContext": {
		"axiom-blocks/accordionShowIcon":     "showIcon",
		"axiom-blocks/accordionIconSlug":     "iconSlug",
		"axiom-blocks/accordionIconPosition": "iconPosition",
		"axiom-blocks/accordionHeadingLevel": "headingLevel"
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./editor.scss",
	"style":        "file:./style.scss",
	"viewScript":   "file:./assets/accordion.js",
	"render":       "file:./render.php"
}
