{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/social-share",
	"version": "1.1.0",
	"title": "Social Share",
	"category": "axiom-blocks",
	"description": "Share buttons for the page or the post in context, with copy link and the device's share sheet. Works without JavaScript.",
	"keywords": [
		"share",
		"social",
		"facebook",
		"x",
		"linkedin",
		"whatsapp",
		"copy link"
	],
	"textdomain": "axiom-blocks",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{
					"network": "facebook"
				},
				{
					"network": "x"
				},
				{
					"network": "linkedin"
				},
				{
					"network": "whatsapp"
				},
				{
					"network": "email"
				},
				{
					"network": "copy"
				}
			]
		},
		"shareSource": {
			"type": "string",
			"default": "post"
		},
		"shareUrl": {
			"type": "string",
			"default": ""
		},
		"shareTitle": {
			"type": "string",
			"default": ""
		},
		"shareText": {
			"type": "string",
			"default": ""
		},
		"xVia": {
			"type": "string",
			"default": ""
		},
		"hashtags": {
			"type": "string",
			"default": ""
		},
		"openIn": {
			"type": "string",
			"default": "popup"
		},
		"display": {
			"type": "string",
			"default": "icon"
		},
		"leadText": {
			"type": "string",
			"default": "Share this"
		},
		"shape": {
			"type": "string",
			"default": "rounded"
		},
		"variant": {
			"type": "string",
			"default": "filled"
		},
		"hoverEffect": {
			"type": "string",
			"default": "none"
		},
		"direction": {
			"type": "string",
			"default": "row"
		},
		"justify": {
			"type": "string",
			"default": "flex-start"
		},
		"floating": {
			"type": "string",
			"default": ""
		},
		"floatOffset": {
			"type": "string",
			"default": "30%"
		},
		"floatMobile": {
			"type": "string",
			"default": "bar"
		},
		"copiedText": {
			"type": "string",
			"default": "Copied"
		},
		"showLead": {
			"type": "boolean",
			"default": false
		},
		"brandColors": {
			"type": "boolean",
			"default": true
		},
		"wrap": {
			"type": "boolean",
			"default": true
		},
		"equalWidth": {
			"type": "boolean",
			"default": false
		},
		"barBgType": {
			"type": "string",
			"default": ""
		},
		"barBgGradType": {
			"type": "string",
			"default": "linear"
		},
		"barBgGradAngle": {
			"type": "number",
			"default": 90
		},
		"barBgGradStops": {
			"type": "array",
			"default": []
		},
		"barBgImage": {
			"type": "object",
			"default": null
		},
		"barBgImageSize": {
			"type": "string",
			"default": "cover"
		},
		"barBgImagePosition": {
			"type": "string",
			"default": "center center"
