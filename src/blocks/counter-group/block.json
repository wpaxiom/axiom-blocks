{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/counter-group",
	"version": "1.0.0",
	"title": "Counter",
	"category": "axiom-blocks",
	"description": "Animated count-up statistics — number, optional icon and label, that count up when scrolled into view. Add as many stats as you need in a responsive row.",
	"keywords": ["counter", "count up", "stats", "number", "statistics"],
	"textdomain": "axiom-blocks",
	"icon": "chart-bar",
	"attributes": {
		"columns":       { "type": "number",  "default": 3 },
		"gap":           { "type": "string",  "default": "" },
		"stackOnMobile": { "type": "boolean", "default": true },
		"showDivider":   { "type": "boolean", "default": false },
		"dividerColor":  { "type": "string",  "default": "" },

		"duration":              { "type": "number",  "default": 2000 },
		"thousandsSeparator":    { "type": "boolean", "default": true },
		"thousandsSeparatorChar":{ "type": "string",  "default": "," },
		"decimalSeparatorChar":  { "type": "string",  "default": "." },
		"easing":                { "type": "string",  "default": "ease-out" },

		"iconPosition":  { "type": "string", "default": "top" },
		"iconColor":     { "type": "string", "default": "" },
		"iconHoverColor":{ "type": "string", "default": "" },
		"iconSize":      { "type": "string", "default": "" },

		"iconChipColor":          { "type": "string", "default": "" },
		"iconChipColorHover":     { "type": "string", "default": "" },
		"iconChipBorderColor":    { "type": "string", "default": "" },
		"iconChipBorderColorHover": { "type": "string", "default": "" },
		"iconChipBorderStyle":    { "type": "string", "default": "" },
		"iconChipBorderTopWidth":    { "type": "string", "default": "" },
		"iconChipBorderRightWidth":  { "type": "string", "default": "" },
		"iconChipBorderBottomWidth": { "type": "string", "default": "" },
		"iconChipBorderLeftWidth":   { "type": "string", "default": "" },
		"iconChipBorderTopWidthHover":    { "type": "string", "default": "" },
		"iconChipBorderRightWidthHover":  { "type": "string", "default": "" },
		"iconChipBorderBottomWidthHover": { "type": "string", "default": "" },
		"iconChipBorderLeftWidthHover":   { "type": "string", "default": "" },
		"iconChipRadiusTopLeft":     { "type": "string", "default": "" },
		"iconChipRadiusTopRight":    { "type": "string", "default": "" },
		"iconChipRadiusBottomRight": { "type": "string", "default": "" },
		"iconChipRadiusBottomLeft":  { "type": "string", "default": "" },
		"iconChipPaddingTop":    { "type": "string", "default": "" },
		"iconChipPaddingRight":  { "type": "string", "default": "" },
		"iconChipPaddingBottom": { "type": "string", "default": "" },
		"iconChipPaddingLeft":   { "type": "string", "default": "" },

		"iconChipBgType":             { "type": "string",  "default": "" },
		"iconChipBgGradType":         { "type": "string",  "default": "linear" },
		"iconChipBgGradAngle":        { "type": "number",  "default": 90 },
		"iconChipBgGradStops":        { "type": "array",   "default": [] },
		"iconChipBgImage":            { "type": "object",  "default": null },
		"iconChipBgImageSize":        { "type": "string",  "default": "cover" },
		"iconChipBgImagePosition":    { "type": "string",  "default": "center center" },
		"iconChipBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"iconChipBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"iconChipBgParallax":         { "type": "boolean", "default": false },
		"iconChipBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"iconChipBgOverlay":          { "type": "string",  "default": "" },
		"iconChipBgOverlayType":      { "type": "string",  "default": "color" },
		"iconChipBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"iconChipBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"iconChipBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"iconChipBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"iconChipBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"iconChipBgOverlayBlend":     { "type": "string",  "default": "normal" },

		"iconChipHoverBgType":             { "type": "string",  "default": "" },
		"iconChipHoverBgGradType":         { "type": "string",  "default": "linear" },
		"iconChipHoverBgGradAngle":        { "type": "number",  "default": 90 },
		"iconChipHoverBgGradStops":        { "type": "array",   "default": [] },
		"iconChipHoverBgImage":            { "type": "object",  "default": null },
		"iconChipHoverBgImageSize":        { "type": "string",  "default": "cover" },
		"iconChipHoverBgImagePosition":    { "type": "string",  "default": "center center" },
		"iconChipHoverBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"iconChipHoverBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"iconChipHoverBgParallax":         { "type": "boolean", "default": false },
		"iconChipHoverBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"iconChipHoverBgOverlay":          { "type": "string",  "default": "" },
		"iconChipHoverBgOverlayType":      { "type": "string",  "default": "color" },
		"iconChipHoverBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"iconChipHoverBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"iconChipHoverBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"iconChipHoverBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"iconChipHoverBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"iconChipHoverBgOverlayBlend":     { "type": "string",  "default": "normal" },

		"numberColor":      { "type": "string", "default": "" },
		"numberHoverColor": { "type": "string", "default": "" },

		"labelPosition":   { "type": "string", "default": "below" },
		"labelColor":      { "type": "string", "default": "" },
		"labelHoverColor": { "type": "string", "default": "" },

		"numberFontFamily":     { "type": "string", "default": "" },
		"numberFontWeight":     { "type": "string", "default": "" },
		"numberFontSize":       { "type": "string", "default": "" },
		"numberLineHeight":     { "type": "string", "default": "" },
		"numberLetterSpacing":  { "type": "string", "default": "" },
		"numberTextTransform":  { "type": "string", "default": "" },
		"numberTextDecoration": { "type": "string", "default": "" },
		"numberTextAlign":      { "type": "string", "default": "" },

		"labelFontFamily":     { "type": "string", "default": "" },
		"labelFontWeight":     { "type": "string", "default": "" },
		"labelFontSize":       { "type": "string", "default": "" },
		"labelLineHeight":     { "type": "string", "default": "" },
		"labelLetterSpacing":  { "type": "string", "default": "" },
		"labelTextTransform":  { "type": "string", "default": "" },
		"labelTextDecoration": { "type": "string", "default": "" },
		"labelTextAlign":      { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" },

		"cardBackground":   { "type": "string", "default": "" },
		"cardBorderColor":  { "type": "string", "default": "" },
		"cardBorderWidth":  { "type": "string", "default": "" },
		"cardBorderRadius": { "type": "string", "default": "" },
		"cardShadow":       { "type": "string", "default": "" },
		"cardPaddingTop":    { "type": "string", "default": "" },
		"cardPaddingRight":  { "type": "string", "default": "" },
		"cardPaddingBottom": { "type": "string", "default": "" },
		"cardPaddingLeft":   { "type": "string", "default": "" },

		"borderStyle": { "type": "string", "default": "" },
		"cardBorderTopWidth":    { "type": "string", "default": "" },
		"cardBorderRightWidth":  { "type": "string", "default": "" },
		"cardBorderBottomWidth": { "type": "string", "default": "" },
		"cardBorderLeftWidth":   { "type": "string", "default": "" },
		"cardRadiusTopLeft":     { "type": "string", "default": "" },
		"cardRadiusTopRight":    { "type": "string", "default": "" },
		"cardRadiusBottomRight": { "type": "string", "default": "" },
		"cardRadiusBottomLeft":  { "type": "string", "default": "" },
		"cardShadowCustom":      { "type": "string", "default": "" },
		"cardMinHeight":         { "type": "string", "default": "" },
		"cardBackgroundHover":   { "type": "string", "default": "" },

		"cardBgType":             { "type": "string",  "default": "" },
		"cardBgGradType":         { "type": "string",  "default": "linear" },
		"cardBgGradAngle":        { "type": "number",  "default": 90 },
		"cardBgGradStops":        { "type": "array",   "default": [] },
		"cardBgImage":            { "type": "object",  "default": null },
		"cardBgImageSize":        { "type": "string",  "default": "cover" },
		"cardBgImagePosition":    { "type": "string",  "default": "center center" },
		"cardBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"cardBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"cardBgParallax":         { "type": "boolean", "default": false },
		"cardBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"cardBgOverlay":          { "type": "string",  "default": "" },
		"cardBgOverlayType":      { "type": "string",  "default": "color" },
		"cardBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"cardBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"cardBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"cardBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"cardBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"cardBgOverlayBlend":     { "type": "string",  "default": "normal" },

		"cardHoverBgType":             { "type": "string",  "default": "" },
		"cardHoverBgGradType":         { "type": "string",  "default": "linear" },
		"cardHoverBgGradAngle":        { "type": "number",  "default": 90 },
		"cardHoverBgGradStops":        { "type": "array",   "default": [] },
		"cardHoverBgImage":            { "type": "object",  "default": null },
		"cardHoverBgImageSize":        { "type": "string",  "default": "cover" },
		"cardHoverBgImagePosition":    { "type": "string",  "default": "center center" },
		"cardHoverBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"cardHoverBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"cardHoverBgParallax":         { "type": "boolean", "default": false },
		"cardHoverBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"cardHoverBgOverlay":          { "type": "string",  "default": "" },
		"cardHoverBgOverlayType":      { "type": "string",  "default": "color" },
		"cardHoverBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"cardHoverBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"cardHoverBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"cardHoverBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"cardHoverBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"cardHoverBgOverlayBlend":     { "type": "string",  "default": "normal" }
	},
	"providesContext": {
		"axiom-blocks/counterSeparator": "thousandsSeparator",
		"axiom-blocks/counterThousandsSep": "thousandsSeparatorChar",
		"axiom-blocks/counterDecimalSep": "decimalSeparatorChar"
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./editor.scss",
	"style":        "file:./style.scss",
	"viewScript":   "file:./assets/counter.js",
	"render":       "file:./render.php"
}
