{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/info-box",
	"version": "1.0.0",
	"title": "Info Box",
	"category": "axiom-blocks",
	"description": "A styled box that holds any blocks — an icon, heading, text, and button — with full control over the spacing between them.",
	"keywords": ["info box", "feature", "icon box", "card", "service"],
	"textdomain": "axiom-blocks",
	"icon": "info",
	"attributes": {
		"direction":    { "type": "string", "default": "column" },
		"gap":          { "type": "string", "default": "" },
		"contentAlign": { "type": "string", "default": "center" },

		"bgColor":      { "type": "string", "default": "" },
		"bgColorHover": { "type": "string", "default": "" },
		"borderColor":  { "type": "string", "default": "" },
		"borderWidth":  { "type": "string", "default": "" },
		"borderStyle":  { "type": "string", "default": "" },
		"borderRadius": { "type": "string", "default": "" },
		"boxShadow":    { "type": "string", "default": "none" },
		"boxShadowCustom":      { "type": "string", "default": "" },
		"boxShadowCustomHover": { "type": "string", "default": "" },
		"hoverLift":    { "type": "number", "default": 0 },

		"borderTopWidth":    { "type": "string", "default": "" },
		"borderRightWidth":  { "type": "string", "default": "" },
		"borderBottomWidth": { "type": "string", "default": "" },
		"borderLeftWidth":   { "type": "string", "default": "" },
		"radiusTopLeft":     { "type": "string", "default": "" },
		"radiusTopRight":    { "type": "string", "default": "" },
		"radiusBottomRight": { "type": "string", "default": "" },
		"radiusBottomLeft":  { "type": "string", "default": "" },

		"cardWidth":           { "type": "string", "default": "" },
		"cardWidthTablet":     { "type": "string", "default": "" },
		"cardWidthMobile":     { "type": "string", "default": "" },
		"cardMaxWidth":        { "type": "string", "default": "" },
		"cardMaxWidthTablet":  { "type": "string", "default": "" },
		"cardMaxWidthMobile":  { "type": "string", "default": "" },
		"cardMinHeight":       { "type": "string", "default": "" },
		"cardMinHeightTablet": { "type": "string", "default": "" },
		"cardMinHeightMobile": { "type": "string", "default": "" },

		"cardBgType":             { "type": "string",  "default": "" },
		"cardBgGradType":         { "type": "string",  "default": "linear" },
		"cardBgGradAngle":        { "type": "number",  "default": 90 },
		"cardBgGradStops":        { "type": "array",   "default": [] },
		"cardBgImage":            { "type": "object",  "default": null },
		"cardBgImageSize":        { "type": "string",  "default": "cover" },
		"cardBgImagePosition":    { "type": "string",  "default": "center center" },
		"cardBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"cardBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"cardBgParallax":         { "type": "boolean", "default": false },
		"cardBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"cardBgOverlay":          { "type": "string",  "default": "" },
		"cardBgOverlayType":      { "type": "string",  "default": "color" },
		"cardBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"cardBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"cardBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"cardBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"cardBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"cardBgOverlayBlend":     { "type": "string",  "default": "normal" },

		"cardHoverBgType":             { "type": "string",  "default": "" },
		"cardHoverBgGradType":         { "type": "string",  "default": "linear" },
		"cardHoverBgGradAngle":        { "type": "number",  "default": 90 },
		"cardHoverBgGradStops":        { "type": "array",   "default": [] },
		"cardHoverBgImage":            { "type": "object",  "default": null },
		"cardHoverBgImageSize":        { "type": "string",  "default": "cover" },
		"cardHoverBgImagePosition":    { "type": "string",  "default": "center center" },
		"cardHoverBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
		"cardHoverBgImageAttachment":  { "type": "string",  "default": "scroll" },
		"cardHoverBgParallax":         { "type": "boolean", "default": false },
		"cardHoverBgParallaxSpeed":    { "type": "number",  "default": 30 },
		"cardHoverBgOverlay":          { "type": "string",  "default": "" },
		"cardHoverBgOverlayType":      { "type": "string",  "default": "color" },
		"cardHoverBgOverlayGradType":  { "type": "string",  "default": "linear" },
		"cardHoverBgOverlayGradAngle": { "type": "number",  "default": 180 },
		"cardHoverBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
		"cardHoverBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
		"cardHoverBgOverlayOpacity":   { "type": "number",  "default": 0 },
		"cardHoverBgOverlayBlend":     { "type": "string",  "default": "normal" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./editor.scss",
	"style":        "file:./style.scss",
	"render":       "file:./render.php"
}
