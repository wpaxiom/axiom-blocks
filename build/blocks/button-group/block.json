{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "axiom-blocks/button-group",
    "version": "1.0.0",
    "title": "Button Group",
    "category": "axiom-blocks",
    "description": "Arrange Advanced Buttons in a row or stack with alignment and gap controls.",
    "keywords": ["button", "buttons", "group", "cta"],
    "textdomain": "axiom-blocks",
    "icon": "button",
    "attributes": {
        "orientation":   { "type": "string",  "default": "horizontal" },
        "justify":       { "type": "string",  "default": "left" },
        "gap":           { "type": "number",  "default": 12 },
        "stackOnMobile": { "type": "boolean", "default": true }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "editorScript": "file:./index.js",
    "style":        "file:./style.scss",
    "render":       "file:./render.php"
}
