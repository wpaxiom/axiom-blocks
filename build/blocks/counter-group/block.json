{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/counter-group",
	"version": "1.0.0",
	"title": "Counter",
	"category": "axiom-blocks",
	"description": "Animated count-up statistics — number, optional icon and label, that count up when scrolled into view. Add as many stats as you need in a responsive row.",
	"keywords": ["counter", "count up", "stats", "number", "statistics"],
	"textdomain": "axiom-blocks",
	"icon": "chart-bar",
	"attributes": {
		"columns":       { "type": "number",  "default": 3 },
		"gap":           { "type": "string",  "default": "" },
		"stackOnMobile": { "type": "boolean", "default": true },
		"showDivider":   { "type": "boolean", "default": false },
		"dividerColor":  { "type": "string",  "default": "" },

		"duration":              { "type": "number",  "default": 2000 },
		"thousandsSeparator":    { "type": "boolean", "default": true },
		"thousandsSeparatorChar":{ "type": "string",  "default": "," },
		"decimalSeparatorChar":  { "type": "string",  "default": "." },
		"easing":                { "type": "string",  "default": "ease-out" },

		"iconPosition":  { "type": "string", "default": "top" },
		"iconColor":     { "type": "string", "default": "" },
		"iconHoverColor":{ "type": "string", "default": "" },
		"iconSize":      { "type": "string", "default": "" },

		"numberColor":      { "type": "string", "default": "" },
		"numberHoverColor": { "type": "string", "default": "" },

		"labelPosition":   { "type": "string", "default": "below" },
		"labelColor":      { "type": "string", "default": "" },
		"labelHoverColor": { "type": "string", "default": "" },

		"numberFontFamily":     { "type": "string", "default": "" },
		"numberFontWeight":     { "type": "string", "default": "" },
		"numberFontSize":       { "type": "string", "default": "" },
		"numberLineHeight":     { "type": "string", "default": "" },
		"numberLetterSpacing":  { "type": "string", "default": "" },
		"numberTextTransform":  { "type": "string", "default": "" },
		"numberTextDecoration": { "type": "string", "default": "" },
		"numberTextAlign":      { "type": "string", "default": "" },

		"labelFontFamily":     { "type": "string", "default": "" },
		"labelFontWeight":     { "type": "string", "default": "" },
		"labelFontSize":       { "type": "string", "default": "" },
		"labelLineHeight":     { "type": "string", "default": "" },
		"labelLetterSpacing":  { "type": "string", "default": "" },
		"labelTextTransform":  { "type": "string", "default": "" },
		"labelTextDecoration": { "type": "string", "default": "" },
		"labelTextAlign":      { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" },

		"cardBackground":   { "type": "string", "default": "" },
		"cardBorderColor":  { "type": "string", "default": "" },
		"cardBorderWidth":  { "type": "string", "default": "" },
		"cardBorderRadius": { "type": "string", "default": "" },
		"cardShadow":       { "type": "string", "default": "" },
		"cardPaddingTop":    { "type": "string", "default": "" },
		"cardPaddingRight":  { "type": "string", "default": "" },
		"cardPaddingBottom": { "type": "string", "default": "" },
		"cardPaddingLeft":   { "type": "string", "default": "" }
	},
	"providesContext": {
		"axiom-blocks/counterSeparator": "thousandsSeparator",
		"axiom-blocks/counterThousandsSep": "thousandsSeparatorChar",
		"axiom-blocks/counterDecimalSep": "decimalSeparatorChar"
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./editor.scss",
	"style":        "file:./style.scss",
	"viewScript":   "file:./assets/counter.js",
	"render":       "file:./render.php"
}
