        "badgeBg":    { "type": "string", "default": "" },
        "badgeColor": { "type": "string", "default": "" },

        "featIconColor":         { "type": "string", "default": "" },
        "featIconExcludedColor": { "type": "string", "default": "" },

        "showCurrency": { "type": "boolean", "default": true },
