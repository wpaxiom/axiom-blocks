{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "axiom-blocks/pricing-table",
    "version": "1.0.0",
    "title": "Pricing Table",
    "category": "axiom-blocks",
    "description": "Pricing plans with feature lists, CTAs, and a highlighted recommendation.",
    "keywords": ["pricing", "plans", "subscription", "tiers", "table"],
    "textdomain": "axiom-blocks",
    "icon": "money-alt",
    "attributes": {
        "columns":           { "type": "number",  "default": 3 },
        "gap":               { "type": "number",  "default": 24 },
        "accentColor":       { "type": "string",  "default": "#7C3AED" },
        "featureIconStyle":  { "type": "string",  "default": "check" },

        "headingShow":   { "type": "boolean", "default": false },
        "headingText":   { "type": "string",  "default": "Choose your plan" },
        "headingAlign":  { "type": "string",  "default": "center" },

        "headingFontFamily":     { "type": "string", "default": "" },
        "headingFontWeight":     { "type": "string", "default": "" },
