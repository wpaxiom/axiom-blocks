        "descColor":    { "type": "string", "default": "" },
        "featureColor": { "type": "string", "default": "" },

        "cardPaddingTop":    { "type": "string", "default": "" },
        "cardPaddingRight":  { "type": "string", "default": "" },
        "cardPaddingBottom": { "type": "string", "default": "" },
