    "providesContext": {
        "axiom-blocks/featureIconStyle": "featureIconStyle",

        "axiom-blocks/cardBg": "cardBg",
        "axiom-blocks/cardBorderTopWidth": "cardBorderTopWidth",
        "axiom-blocks/cardBorderRightWidth": "cardBorderRightWidth",
        "axiom-blocks/cardBorderBottomWidth": "cardBorderBottomWidth",
        "axiom-blocks/cardBorderLeftWidth": "cardBorderLeftWidth",
