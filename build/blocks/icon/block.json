    "bgHoverBgImage": {
      "type": "object",
      "default": null
    },
    "bgHoverBgImageSize": {
      "type": "string",
      "default": "cover"
    },
    "bgHoverBgImagePosition": {
      "type": "string",
      "default": "center center"
    },
    "bgHoverBgImageRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "bgHoverBgImageAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "bgHoverBgParallax": {
      "type": "boolean",
      "default": false
    },
    "bgHoverBgParallaxSpeed": {
      "type": "number",
      "default": 30
    },
    "bgHoverBgOverlay": {
      "type": "string",
      "default": ""
    },
    "bgHoverBgOverlayType": {
      "type": "string",
      "default": "color"
    },
    "bgHoverBgOverlayGradType": {
      "type": "string",
      "default": "linear"
    },
    "bgHoverBgOverlayGradAngle": {
      "type": "number",
      "default": 180
    },
    "bgHoverBgOverlayGradFrom": {
      "type": "string",
      "default": "#000000"
    },
    "bgHoverBgOverlayGradTo": {
      "type": "string",
      "default": "rgba(0,0,0,0)"
    },
    "bgHoverBgOverlayOpacity": {
      "type": "number",
      "default": 0
    },
    "bgHoverBgOverlayBlend": {
      "type": "string",
      "default": "normal"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "relNoFollow": {
      "type": "boolean",
      "default": false
    },
    "relSponsored": {
      "type": "boolean",
      "default": false
    },
    "paddingTop": {
      "type": "string",
      "default": ""
    },
    "paddingRight": {
      "type": "string",
      "default": ""
    },
    "paddingBottom": {
      "type": "string",
      "default": ""
    },
    "paddingLeft": {
      "type": "string",
      "default": ""
    },
    "marginTop": {
      "type": "string",
      "default": ""
    },
    "marginRight": {
      "type": "string",
      "default": ""
    },
    "marginBottom": {
      "type": "string",
      "default": ""
    },
    "marginLeft": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "render": "file:./render.php"
}