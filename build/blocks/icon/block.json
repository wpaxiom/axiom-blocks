    "shapePaddingBottom": {
      "type": "string",
      "default": ""
    },
    "shapePaddingLeft": {
      "type": "string",
      "default": ""
    },
    "shapeRadius": {
      "type": "string",
      "default": ""
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderWidth": {
      "type": "string",
      "default": ""
    },
    "borderStyle": {
      "type": "string",
      "default": "solid"
    },
    "borderTopWidth": {
      "type": "string",
      "default": ""
    },
    "borderRightWidth": {
      "type": "string",
      "default": ""
    },
    "borderBottomWidth": {
      "type": "string",
      "default": ""
    },
    "borderLeftWidth": {
      "type": "string",
      "default": ""
    },
    "shapeRadiusTopLeft": {
      "type": "string",
      "default": ""
    },
    "shapeRadiusTopRight": {
      "type": "string",
      "default": ""
