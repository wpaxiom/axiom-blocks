{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axiom-blocks/icon",
  "version": "1.0.0",
  "title": "Icon",
  "category": "axiom-blocks",
  "description": "Pick an icon from the library, then style its size, color, shape, and link.",
  "keywords": [
    "icon",
    "svg",
    "shape",
    "symbol"
  ],
  "textdomain": "axiom-blocks",
  "icon": "star-filled",
  "attributes": {
    "iconSlug": {
      "type": "string",
      "default": "star"
    },
    "iconLabel": {
      "type": "string",
      "default": ""
    },
    "iconSize": {
      "type": "string",
      "default": ""
    },
    "iconColor": {
      "type": "string",
      "default": ""
    },
    "iconHoverColor": {
      "type": "string",
      "default": ""
    },
    "rotation": {
      "type": "number",
      "default": 0
    },
    "iconAlign": {
      "type": "string",
      "default": "center"
    },
    "shape": {
      "type": "string",
      "default": "none"
    },
    "bgColor": {
      "type": "string",
      "default": ""
    },
    "bgHoverColor": {
      "type": "string",
      "default": ""
    },
    "shapePadding": {
      "type": "string",
      "default": ""
    },
    "shapePaddingTop": {
      "type": "string",
      "default": ""
