      "type": "string",
      "default": "rgba(0,0,0,0)"
    },
    "shapeBgBgOverlayOpacity": {
      "type": "number",
      "default": 0
    },
    "shapeBgBgOverlayBlend": {
      "type": "string",
      "default": "normal"
