    "shapeRadiusBottomRight": {
      "type": "string",
      "default": ""
    },
    "shapeRadiusBottomLeft": {
      "type": "string",
      "default": ""
    },
    "shapeShadow": {
      "type": "string",
      "default": ""
    },
    "shapeBgBgType": {
      "type": "string",
      "default": ""
    },
    "shapeBgBgGradType": {
      "type": "string",
      "default": "linear"
    },
    "shapeBgBgGradAngle": {
      "type": "number",
      "default": 90
    },
    "shapeBgBgGradStops": {
      "type": "array",
      "default": []
    },
    "shapeBgBgImage": {
      "type": "object",
      "default": null
    },
    "shapeBgBgImageSize": {
      "type": "string",
      "default": "cover"
    },
    "shapeBgBgImagePosition": {
      "type": "string",
      "default": "center center"
    },
    "shapeBgBgImageRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "shapeBgBgImageAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "shapeBgBgParallax": {
      "type": "boolean",
      "default": false
    },
    "shapeBgBgParallaxSpeed": {
      "type": "number",
      "default": 30
    },
    "shapeBgBgOverlay": {
      "type": "string",
      "default": ""
    },
    "shapeBgBgOverlayType": {
      "type": "string",
      "default": "color"
    },
    "shapeBgBgOverlayGradType": {
      "type": "string",
      "default": "linear"
