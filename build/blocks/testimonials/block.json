{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/testimonials",
	"version": "1.0.0",
	"title": "Testimonials",
	"category": "axiom-blocks",
	"description": "Social-proof testimonials in a grid, carousel, or continuous marquee — avatars, star ratings, quote icon, verified source badges, and opt-in review schema.",
	"keywords": ["testimonial", "review", "quote", "carousel", "rating"],
	"textdomain": "axiom-blocks",
	"icon": "format-quote",
	"attributes": {
		"layout":        { "type": "string",  "default": "grid" },
		"columns":       { "type": "number",  "default": 3 },
		"gap":           { "type": "string",  "default": "" },
		"stackOnMobile": { "type": "boolean", "default": true },

		"autoplay":      { "type": "boolean", "default": false },
		"autoplaySpeed": { "type": "number",  "default": 4000 },
		"loop":          { "type": "boolean", "default": true },
		"pauseOnHover":  { "type": "boolean", "default": true },
		"showArrows":    { "type": "boolean", "default": true },
		"showDots":      { "type": "boolean", "default": true },
		"slideSpeed":    { "type": "number",  "default": 500 },

		"marqueeSpeed":        { "type": "number",  "default": 30 },
		"marqueeReverse":      { "type": "boolean", "default": false },
		"marqueePauseOnHover": { "type": "boolean", "default": true },

		"cardBg":          { "type": "string",  "default": "" },
		"cardBorderColor": { "type": "string",  "default": "" },
		"cardBorderWidth": { "type": "string",  "default": "" },
		"cardRadius":      { "type": "string",  "default": "" },
		"cardShadow":      { "type": "boolean", "default": true },
		"cardGap":         { "type": "string",  "default": "" },

		"cardPaddingTop":    { "type": "string", "default": "" },
		"cardPaddingRight":  { "type": "string", "default": "" },
		"cardPaddingBottom": { "type": "string", "default": "" },
		"cardPaddingLeft":   { "type": "string", "default": "" },

		"avatarPosition": { "type": "string", "default": "top" },
		"avatarSize":     { "type": "string", "default": "" },
		"avatarShape":    { "type": "string", "default": "circle" },

		"showRating":  { "type": "boolean", "default": true },
		"ratingColor": { "type": "string",  "default": "" },

		"showQuoteIcon":  { "type": "boolean", "default": true },
		"quoteIconColor": { "type": "string",  "default": "" },

		"readMore":      { "type": "boolean", "default": false },
		"readMoreLines": { "type": "number",  "default": 4 },

		"reviewSchema": { "type": "boolean", "default": false },
		"itemName":     { "type": "string",  "default": "" },

		"monoBg":       { "type": "string", "default": "" },
		"monoColor":    { "type": "string", "default": "" },

		"nameColor":    { "type": "string", "default": "" },
		"roleColor":    { "type": "string", "default": "" },
		"companyColor": { "type": "string", "default": "" },
		"quoteColor":   { "type": "string", "default": "" },

		"nameFontFamily":     { "type": "string", "default": "" },
		"nameFontWeight":     { "type": "string", "default": "" },
		"nameFontSize":       { "type": "string", "default": "" },
		"nameLineHeight":     { "type": "string", "default": "" },
		"nameLetterSpacing":  { "type": "string", "default": "" },
		"nameTextTransform":  { "type": "string", "default": "" },
		"nameTextDecoration": { "type": "string", "default": "" },
		"nameTextAlign":      { "type": "string", "default": "" },

		"roleFontFamily":     { "type": "string", "default": "" },
		"roleFontWeight":     { "type": "string", "default": "" },
		"roleFontSize":       { "type": "string", "default": "" },
		"roleLineHeight":     { "type": "string", "default": "" },
		"roleLetterSpacing":  { "type": "string", "default": "" },
		"roleTextTransform":  { "type": "string", "default": "" },
		"roleTextDecoration": { "type": "string", "default": "" },
		"roleTextAlign":      { "type": "string", "default": "" },

		"companyFontFamily":     { "type": "string", "default": "" },
		"companyFontWeight":     { "type": "string", "default": "" },
		"companyFontSize":       { "type": "string", "default": "" },
		"companyLineHeight":     { "type": "string", "default": "" },
		"companyLetterSpacing":  { "type": "string", "default": "" },
		"companyTextTransform":  { "type": "string", "default": "" },
		"companyTextDecoration": { "type": "string", "default": "" },
		"companyTextAlign":      { "type": "string", "default": "" },

		"monoFontFamily":     { "type": "string", "default": "" },
		"monoFontWeight":     { "type": "string", "default": "" },
		"monoFontSize":       { "type": "string", "default": "" },
		"monoLineHeight":     { "type": "string", "default": "" },
		"monoLetterSpacing":  { "type": "string", "default": "" },
		"monoTextTransform":  { "type": "string", "default": "" },
		"monoTextDecoration": { "type": "string", "default": "" },
		"monoTextAlign":      { "type": "string", "default": "" },

		"quoteFontFamily":     { "type": "string", "default": "" },
		"quoteFontWeight":     { "type": "string", "default": "" },
		"quoteFontSize":       { "type": "string", "default": "" },
		"quoteLineHeight":     { "type": "string", "default": "" },
		"quoteLetterSpacing":  { "type": "string", "default": "" },
		"quoteTextTransform":  { "type": "string", "default": "" },
		"quoteTextDecoration": { "type": "string", "default": "" },
		"quoteTextAlign":      { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" },

		"cardBorderTopWidth":    { "type": "string", "default": "" },
		"cardBorderRightWidth":  { "type": "string", "default": "" },
		"cardBorderBottomWidth": { "type": "string", "default": "" },
		"cardBorderLeftWidth":   { "type": "string", "default": "" },
		"borderStyle":           { "type": "string", "default": "" },
		"cardRadiusTopLeft":     { "type": "string", "default": "" },
		"cardRadiusTopRight":    { "type": "string", "default": "" },
		"cardRadiusBottomRight": { "type": "string", "default": "" },
		"cardRadiusBottomLeft":  { "type": "string", "default": "" },
		"cardShadowCustom":      { "type": "string", "default": "" },
		"cardMinHeight":         { "type": "string", "default": "" },
		"cardBgHover":           { "type": "string", "default": "" },
		"cardShadowCustomHover": { "type": "string", "default": "" },
		"hoverLift":             { "type": "string", "default": "" },
		"navColor":              { "type": "string", "default": "" },
		"avatarBorderTopWidth":    { "type": "string", "default": "" },
		"avatarBorderRightWidth":  { "type": "string", "default": "" },
		"avatarBorderBottomWidth": { "type": "string", "default": "" },
		"avatarBorderLeftWidth":   { "type": "string", "default": "" },
		"avatarBorderColor":       { "type": "string", "default": "" },

		"cardBgType":            { "type": "string", "default": "" },
		"cardBgColor":           { "type": "string", "default": "" },
		"cardBgGradType":        { "type": "string", "default": "linear" },
		"cardBgGradAngle":       { "type": "number", "default": 90 },
		"cardBgGradStops":       { "type": "array", "default": [] },
		"cardBgImage":           { "type": "object", "default": null },
		"cardBgImageSize":       { "type": "string", "default": "cover" },
		"cardBgImagePosition":   { "type": "string", "default": "center center" },
		"cardBgImageRepeat":     { "type": "string", "default": "no-repeat" },
		"cardBgImageAttachment": { "type": "string", "default": "scroll" },
		"cardBgParallax":        { "type": "boolean", "default": false },
		"cardBgParallaxSpeed":   { "type": "number", "default": 30 },
		"cardBgOverlay":         { "type": "string", "default": "" },
		"cardBgOverlayType":     { "type": "string", "default": "color" },
		"cardBgOverlayGradType": { "type": "string", "default": "linear" },
		"cardBgOverlayGradAngle":{ "type": "number", "default": 180 },
		"cardBgOverlayGradFrom": { "type": "string", "default": "#000000" },
		"cardBgOverlayGradTo":   { "type": "string", "default": "rgba(0,0,0,0)" },
		"cardBgOverlayOpacity":  { "type": "number", "default": 0 },
		"cardBgOverlayBlend":    { "type": "string", "default": "normal" },

		"cardHoverBgType":            { "type": "string", "default": "" },
		"cardHoverBgColor":           { "type": "string", "default": "" },
		"cardHoverBgGradType":        { "type": "string", "default": "linear" },
		"cardHoverBgGradAngle":       { "type": "number", "default": 90 },
		"cardHoverBgGradStops":       { "type": "array", "default": [] },
		"cardHoverBgImage":           { "type": "object", "default": null },
		"cardHoverBgImageSize":       { "type": "string", "default": "cover" },
		"cardHoverBgImagePosition":   { "type": "string", "default": "center center" },
		"cardHoverBgImageRepeat":     { "type": "string", "default": "no-repeat" },
		"cardHoverBgImageAttachment": { "type": "string", "default": "scroll" },
		"cardHoverBgParallax":        { "type": "boolean", "default": false },
		"cardHoverBgParallaxSpeed":   { "type": "number", "default": 30 },
		"cardHoverBgOverlay":         { "type": "string", "default": "" },
		"cardHoverBgOverlayType":     { "type": "string", "default": "color" },
		"cardHoverBgOverlayGradType": { "type": "string", "default": "linear" },
		"cardHoverBgOverlayGradAngle":{ "type": "number", "default": 180 },
		"cardHoverBgOverlayGradFrom": { "type": "string", "default": "#000000" },
		"cardHoverBgOverlayGradTo":   { "type": "string", "default": "rgba(0,0,0,0)" },
		"cardHoverBgOverlayOpacity":  { "type": "number", "default": 0 },
		"cardHoverBgOverlayBlend":    { "type": "string", "default": "normal" },

		"avatarBorderStyle":       { "type": "string", "default": "" }
	},
	"providesContext": {
		"axiom-blocks/testimonialsAvatarShape": "avatarShape"
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./editor.scss",
	"style":        "file:./style.scss",
	"viewScript":   "file:./assets/testimonials.js",
	"render":       "file:./render.php"
}
