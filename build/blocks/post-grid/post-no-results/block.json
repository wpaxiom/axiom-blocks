{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/post-no-results",
	"version": "1.0.0",
	"title": "No Results",
	"category": "axiom-blocks",
	"description": "Shown inside a Post Grid when the query returns nothing. Holds any blocks.",
	"textdomain": "axiom-blocks",
	"icon": "editor-help",
	"ancestor": ["axiom-blocks/post-grid"],
	"usesContext": ["axiom-blocks/pgHasResults"],
	"attributes": {
		"boxBg":          { "type": "string", "default": "" },
		"boxShadow":      { "type": "string", "default": "" },
		"boxBorderStyle": { "type": "string", "default": "" },
		"boxBorderColor": { "type": "string", "default": "" },

		"boxBorderTopWidth":    { "type": "string", "default": "" },
		"boxBorderRightWidth":  { "type": "string", "default": "" },
		"boxBorderBottomWidth": { "type": "string", "default": "" },
		"boxBorderLeftWidth":   { "type": "string", "default": "" },

		"boxRadiusTopLeft":     { "type": "string", "default": "" },
		"boxRadiusTopRight":    { "type": "string", "default": "" },
		"boxRadiusBottomRight": { "type": "string", "default": "" },
		"boxRadiusBottomLeft":  { "type": "string", "default": "" },

		"boxPaddingTop":    { "type": "string", "default": "" },
		"boxPaddingRight":  { "type": "string", "default": "" },
		"boxPaddingBottom": { "type": "string", "default": "" },
		"boxPaddingLeft":   { "type": "string", "default": "" },

		"marginTop":    { "type": "string", "default": "" },
		"marginRight":  { "type": "string", "default": "" },
		"marginBottom": { "type": "string", "default": "" },
		"marginLeft":   { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render":       "file:./render.php"
}
