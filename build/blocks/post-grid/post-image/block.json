{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/post-image",
	"version": "1.0.0",
	"title": "Post Image",
	"category": "axiom-blocks",
	"description": "The post's featured image, with a fallback for posts that have none.",
	"textdomain": "axiom-blocks",
	"icon": "format-image",
	"ancestor": ["axiom-blocks/post-card", "core/post-template"],
	"usesContext": ["postId", "postType"],
	"attributes": {
		"imageSize":   { "type": "string",  "default": "large" },
		"aspectRatio": { "type": "string",  "default": "16/9" },
		"scaleMode":   { "type": "string",  "default": "cover" },
		"isLink":      { "type": "boolean", "default": true },
		"linkTarget":  { "type": "string",  "default": "" },

		"fallbackId":  { "type": "number", "default": 0 },
		"fallbackUrl": { "type": "string", "default": "" },
		"fallbackAlt": { "type": "string", "default": "" },
		"hideIfEmpty": { "type": "boolean", "default": false },

		"height":       { "type": "string", "default": "" },
		"heightTablet": { "type": "string", "default": "" },
		"heightMobile": { "type": "string", "default": "" },

		"overlayColor":      { "type": "string", "default": "" },
		"overlayColorHover": { "type": "string", "default": "" },

		"imgBorderTopWidth":    { "type": "string", "default": "" },
		"imgBorderRightWidth":  { "type": "string", "default": "" },
		"imgBorderBottomWidth": { "type": "string", "default": "" },
		"imgBorderLeftWidth":   { "type": "string", "default": "" },
		"imgBorderStyle":       { "type": "string", "default": "" },
		"imgBorderColor":       { "type": "string", "default": "" },

		"imgRadiusTopLeft":     { "type": "string", "default": "" },
		"imgRadiusTopRight":    { "type": "string", "default": "" },
		"imgRadiusBottomRight": { "type": "string", "default": "" },
		"imgRadiusBottomLeft":  { "type": "string", "default": "" },

		"imgShadow":      { "type": "string", "default": "" },
		"imgShadowHover": { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render":       "file:./render.php"
}
