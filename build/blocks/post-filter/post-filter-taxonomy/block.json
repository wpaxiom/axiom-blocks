{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/post-filter-taxonomy",
	"version": "1.0.8",
	"title": "Taxonomy Filter",
	"category": "axiom-blocks",
	"description": "A drop-down that narrows a Post Filter bar by a taxonomy. Uses the taxonomy chosen in the bar.",
	"keywords": ["filter", "taxonomy", "category", "tag", "posts"],
	"textdomain": "axiom-blocks",
	"icon": "category",
	"parent": ["axiom-blocks/post-filter"],
	"usesContext": ["axiom-blocks/postFilterTaxonomy"],
	"attributes": {
		"showLabel":     { "type": "boolean", "default": true },
		"labelPosition": { "type": "string", "default": "" },
		"labelGap":      { "type": "string", "default": "" },
		"width":         { "type": "string", "default": "" },
		"widthCustom":   { "type": "string", "default": "" },
		"label":        { "type": "string", "default": "" },
		"placeholder":  { "type": "string", "default": "" },
		"showAll":      { "type": "boolean", "default": true },
		"allLabel":     { "type": "string", "default": "All" },

		"selectColor":      { "type": "string", "default": "" },
		"selectColorHover": { "type": "string", "default": "" },
		"selectBg":         { "type": "string", "default": "" },
		"selectBgHover":    { "type": "string", "default": "" },
		"selectBorderTopWidth":    { "type": "string", "default": "" },
		"selectBorderRightWidth":  { "type": "string", "default": "" },
		"selectBorderBottomWidth": { "type": "string", "default": "" },
		"selectBorderLeftWidth":   { "type": "string", "default": "" },
		"selectBorderStyle":       { "type": "string", "default": "" },
		"selectBorderColor":       { "type": "string", "default": "" },
		"selectBorderColorHover":  { "type": "string", "default": "" },
		"selectRadiusTopLeft":     { "type": "string", "default": "" },
		"selectRadiusTopRight":    { "type": "string", "default": "" },
		"selectRadiusBottomRight": { "type": "string", "default": "" },
		"selectRadiusBottomLeft":  { "type": "string", "default": "" },
		"selectShadow":      { "type": "string", "default": "" },
		"selectPaddingTop":    { "type": "string", "default": "" },
		"selectPaddingRight":  { "type": "string", "default": "" },
		"selectPaddingBottom": { "type": "string", "default": "" },
		"selectPaddingLeft":   { "type": "string", "default": "" },
		"fontFamily":     { "type": "string", "default": "" },
		"fontWeight":     { "type": "string", "default": "" },
		"fontSize":       { "type": "string", "default": "" },
		"lineHeight":     { "type": "string", "default": "" },
		"letterSpacing":  { "type": "string", "default": "" },
		"textTransform":  { "type": "string", "default": "" },
		"textDecoration": { "type": "string", "default": "" },
		"textAlign":      { "type": "string", "default": "" },

		"paddingTop":    { "type": "string", "default": "" },
		"paddingRight":  { "type": "string", "default": "" },
		"paddingBottom": { "type": "string", "default": "" },
		"paddingLeft":   { "type": "string", "default": "" },
		"marginTop":     { "type": "string", "default": "" },
		"marginRight":   { "type": "string", "default": "" },
		"marginBottom":  { "type": "string", "default": "" },
		"marginLeft":    { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": false
	},
	"editorScript": "file:./index.js",
	"render":       "file:./render.php"
}
