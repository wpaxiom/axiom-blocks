{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axiom-blocks/countdown-timer",
  "version": "1.0.0",
  "title": "Countdown Timer",
  "category": "axiom-blocks",
  "description": "Live countdown timer with customizable target date and styling.",
  "keywords": ["countdown", "timer", "count down", "deadline", "urgency"],
  "textdomain": "axiom-blocks",
  "icon": "clock",
  "attributes": {
    "targetDate": {
      "type": "string",
      "default": ""
    },
    "showDays": {
      "type": "boolean",
      "default": true
    },
    "showHours": {
      "type": "boolean",
      "default": true
    },
    "showMinutes": {
      "type": "boolean",
      "default": true
    },
    "showSeconds": {
      "type": "boolean",
      "default": true
    },
    "labelDays": {
      "type": "string",
      "default": "Days"
    },
    "labelHours": {
      "type": "string",
      "default": "Hours"
    },
    "labelMinutes": {
      "type": "string",
      "default": "Minutes"
    },
    "labelSeconds": {
      "type": "string",
      "default": "Seconds"
    },
    "digitColor": {
      "type": "string",
      "default": "#333333"
    },
    "labelColor": {
      "type": "string",
      "default": "#666666"
    },
    "backgroundColor": {
      "type": "string",
      "default": "#f0f0f0"
    },
    "borderRadius": {
      "type": "string",
      "default": "8px"
    },
    "digitFontSize": {
      "type": "string",
      "default": "48px"
    },
    "labelFontSize": {
      "type": "string",
      "default": "14px"
    },
    "expiredAction": {
      "type": "string",
      "default": "showMessage"
    },
    "expiredMessage": {
      "type": "string",
      "default": "Time's up!"
    },
    "redirectUrl": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "horizontal"
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "gap": {
      "type": "string",
      "default": "20px"
    },

    "borderStyle":       { "type": "string", "default": "" },
    "borderColor":       { "type": "string", "default": "" },
    "borderTopWidth":    { "type": "string", "default": "" },
    "borderRightWidth":  { "type": "string", "default": "" },
    "borderBottomWidth": { "type": "string", "default": "" },
    "borderLeftWidth":   { "type": "string", "default": "" },
    "radiusTopLeft":     { "type": "string", "default": "" },
    "radiusTopRight":    { "type": "string", "default": "" },
    "radiusBottomRight": { "type": "string", "default": "" },
    "radiusBottomLeft":  { "type": "string", "default": "" },
    "digitShadow":       { "type": "string", "default": "" },
    "digitMinWidth":     { "type": "string", "default": "" },

    "digitBgType":             { "type": "string",  "default": "" },
    "digitBgGradType":         { "type": "string",  "default": "linear" },
    "digitBgGradAngle":        { "type": "number",  "default": 90 },
    "digitBgGradStops":        { "type": "array",   "default": [] },
    "digitBgImage":            { "type": "object",  "default": null },
    "digitBgImageSize":        { "type": "string",  "default": "cover" },
    "digitBgImagePosition":    { "type": "string",  "default": "center center" },
    "digitBgImageRepeat":      { "type": "string",  "default": "no-repeat" },
    "digitBgImageAttachment":  { "type": "string",  "default": "scroll" },
    "digitBgParallax":         { "type": "boolean", "default": false },
    "digitBgParallaxSpeed":    { "type": "number",  "default": 30 },
    "digitBgOverlay":          { "type": "string",  "default": "" },
    "digitBgOverlayType":      { "type": "string",  "default": "color" },
    "digitBgOverlayGradType":  { "type": "string",  "default": "linear" },
    "digitBgOverlayGradAngle": { "type": "number",  "default": 180 },
    "digitBgOverlayGradFrom":  { "type": "string",  "default": "#000000" },
    "digitBgOverlayGradTo":    { "type": "string",  "default": "rgba(0,0,0,0)" },
    "digitBgOverlayOpacity":   { "type": "number",  "default": 0 },
    "digitBgOverlayBlend":     { "type": "string",  "default": "normal" },

    "digitFontFamily":     { "type": "string", "default": "" },
    "digitFontWeight":     { "type": "string", "default": "" },
    "digitLineHeight":     { "type": "string", "default": "" },
    "digitLetterSpacing":  { "type": "string", "default": "" },
    "digitTextTransform":  { "type": "string", "default": "" },
    "digitTextDecoration": { "type": "string", "default": "" },
    "digitTextAlign":      { "type": "string", "default": "" },

    "labelFontFamily":     { "type": "string", "default": "" },
    "labelFontWeight":     { "type": "string", "default": "" },
    "labelLineHeight":     { "type": "string", "default": "" },
    "labelLetterSpacing":  { "type": "string", "default": "" },
    "labelTextTransform":  { "type": "string", "default": "" },
    "labelTextDecoration": { "type": "string", "default": "" },
    "labelTextAlign":      { "type": "string", "default": "" },

    "paddingTop":    { "type": "string", "default": "" },
    "paddingRight":  { "type": "string", "default": "" },
    "paddingBottom": { "type": "string", "default": "" },
    "paddingLeft":   { "type": "string", "default": "" },
    "marginTop":     { "type": "string", "default": "" },
    "marginRight":   { "type": "string", "default": "" },
    "marginBottom":  { "type": "string", "default": "" },
    "marginLeft":    { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "script": "file:./assets/countdown.js",
  "render": "file:./render.php"
}
