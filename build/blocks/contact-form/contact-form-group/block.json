{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axiom-blocks/contact-form-group",
	"version": "1.1.0",
	"title": "Field Group",
	"category": "axiom-blocks",
	"description": "A fieldset with a legend that groups fields and lays them out in its own columns.",
	"keywords": [
		"group",
		"fieldset",
		"section",
		"legend"
	],
	"textdomain": "axiom-blocks",
	"parent": [
		"axiom-blocks/contact-form"
	],
	"attributes": {
		"legend": {
			"type": "string",
			"default": ""
		},
		"showLegend": {
			"type": "boolean",
			"default": true
		},
		"span": {
			"type": "number",
			"default": 0
		},
		"order": {
			"type": "number",
			"default": 0
		},
		"columns": {
			"type": "number",
			"default": 1
		},
		"tracks": {
			"type": "string",
			"default": ""
		},
		"paddingTop": {
			"type": "string",
			"default": ""
		},
		"paddingRight": {
			"type": "string",
			"default": ""
		},
		"paddingBottom": {
			"type": "string",
			"default": ""
		},
		"paddingLeft": {
			"type": "string",
			"default": ""
		},
		"marginTop": {
			"type": "string",
			"default": ""
		},
		"marginRight": {
			"type": "string",
			"default": ""
		},
		"marginBottom": {
			"type": "string",
			"default": ""
		},
		"marginLeft": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"axiom-blocks/cfFormId",
		"axiom-blocks/cfRequiredMarker",
		"axiom-blocks/cfRequiredText",
		"axiom-blocks/cfOptionalText",
		"axiom-blocks/cfHelpPosition",
		"axiom-blocks/cfFloating",
		"axiom-blocks/cfErrorDisplay",
		"axiom-blocks/cfLabelPosition"
	],
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
