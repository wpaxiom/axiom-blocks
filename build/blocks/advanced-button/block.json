{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "axiom-blocks/advanced-button",
    "version": "1.0.0",
    "title": "Advanced Button",
    "category": "axiom-blocks",
    "description": "Button with icons, hover states, sub-captions, and style presets.",
    "keywords": ["button", "cta", "link", "icon"],
    "textdomain": "axiom-blocks",
    "icon": "button",
    "attributes": {
        "text":           { "type": "string",  "default": "Click here" },
        "subCaption":     { "type": "string",  "default": "" },
        "showSubCaption": { "type": "boolean", "default": false },

        "url":           { "type": "string",  "default": "" },
        "opensInNewTab": { "type": "boolean", "default": false },
        "relNoFollow":   { "type": "boolean", "default": false },
        "relSponsored":  { "type": "boolean", "default": false },
        "isDownload":    { "type": "boolean", "default": false },
        "htmlType":      { "type": "string",  "default": "link" },

        "icon":         { "type": "string",  "default": "" },
        "iconPosition": { "type": "string",  "default": "right" },
        "iconSize":       { "type": "string",  "default": "" },
        "iconSizeTablet": { "type": "string",  "default": "" },
        "iconSizeMobile": { "type": "string",  "default": "" },
        "iconGap":        { "type": "string",  "default": "" },
        "iconGapTablet":  { "type": "string",  "default": "" },
        "iconGapMobile":  { "type": "string",  "default": "" },
        "iconOnly":     { "type": "boolean", "default": false },
        "iconColor":      { "type": "string", "default": "" },
        "iconColorHover": { "type": "string", "default": "" },

        "stylePreset": { "type": "string", "default": "fill" },
        "sizePreset":  { "type": "string", "default": "md" },

        "textColor":    { "type": "string", "default": "" },
        "bgColor":      { "type": "string", "default": "" },
        "borderColor":  { "type": "string", "default": "" },
        "borderWidth":  { "type": "string", "default": "" },
        "borderStyle":  { "type": "string", "default": "solid" },
        "borderRadius": { "type": "string", "default": "" },

        "borderTopWidth":    { "type": "string", "default": "" },
        "borderRightWidth":  { "type": "string", "default": "" },
        "borderBottomWidth": { "type": "string", "default": "" },
        "borderLeftWidth":   { "type": "string", "default": "" },
        "radiusTopLeft":     { "type": "string", "default": "" },
        "radiusTopRight":    { "type": "string", "default": "" },
        "radiusBottomRight": { "type": "string", "default": "" },
        "radiusBottomLeft":  { "type": "string", "default": "" },

        "buttonMinWidth": { "type": "string", "default": "" },
        "buttonAlign":       { "type": "string", "default": "" },
        "buttonAlignTablet": { "type": "string", "default": "" },
        "buttonAlignMobile": { "type": "string", "default": "" },

        "bgType":        { "type": "string", "default": "" },
        "bgGradType":    { "type": "string", "default": "linear" },
        "bgGradAngle":   { "type": "number", "default": 90 },
        "bgGradStops":   { "type": "array", "default": [] },
        "bgImage":       { "type": "object", "default": null },
        "bgImageSize":   { "type": "string", "default": "cover" },
        "bgImagePosition": { "type": "string", "default": "center center" },
        "bgImageRepeat": { "type": "string", "default": "no-repeat" },
        "bgOverlay":     { "type": "string", "default": "" },

        "hoverTextColor":   { "type": "string", "default": "" },
        "hoverBgColor":     { "type": "string", "default": "" },
        "hoverBgType":      { "type": "string", "default": "" },
        "hoverBgGradType":  { "type": "string", "default": "linear" },
        "hoverBgGradAngle": { "type": "number", "default": 90 },
        "hoverBgGradStops": { "type": "array", "default": [] },
        "hoverBgImage":       { "type": "object", "default": null },
        "hoverBgImageSize":   { "type": "string", "default": "cover" },
        "hoverBgImagePosition": { "type": "string", "default": "center center" },
        "hoverBgImageRepeat": { "type": "string", "default": "no-repeat" },
        "hoverBgOverlay":     { "type": "string", "default": "" },
        "hoverBorderColor":      { "type": "string", "default": "" },
        "hoverBorderTopWidth":    { "type": "string", "default": "" },
        "hoverBorderRightWidth":  { "type": "string", "default": "" },
        "hoverBorderBottomWidth": { "type": "string", "default": "" },
        "hoverBorderLeftWidth":   { "type": "string", "default": "" },
        "hoverBorderStyle":       { "type": "string", "default": "" },
        "hoverEffect":            { "type": "string", "default": "none" },

        "shadow":      { "type": "string", "default": "none" },
        "hoverShadow": { "type": "string", "default": "" },

        "fontFamily":     { "type": "string", "default": "" },
        "fontWeight":     { "type": "string", "default": "" },
        "fontSize":       { "type": "string", "default": "" },
        "lineHeight":     { "type": "string", "default": "" },
        "letterSpacing":  { "type": "string", "default": "" },
        "textTransform":  { "type": "string", "default": "" },
        "textDecoration": { "type": "string", "default": "" },
        "textAlign":      { "type": "string", "default": "" },

        "paddingTop":    { "type": "string", "default": "" },
        "paddingRight":  { "type": "string", "default": "" },
        "paddingBottom": { "type": "string", "default": "" },
        "paddingLeft":   { "type": "string", "default": "" },
        "marginTop":     { "type": "string", "default": "" },
        "marginRight":  { "type": "string", "default": "" },
        "marginBottom": { "type": "string", "default": "" },
        "marginLeft":   { "type": "string", "default": "" },

        "subCaptionFontFamily":     { "type": "string", "default": "" },
        "subCaptionFontWeight":     { "type": "string", "default": "" },
        "subCaptionFontSize":       { "type": "string", "default": "" },
        "subCaptionLineHeight":     { "type": "string", "default": "" },
        "subCaptionLetterSpacing":  { "type": "string", "default": "" },
        "subCaptionTextTransform":  { "type": "string", "default": "" },
        "subCaptionTextDecoration": { "type": "string", "default": "" },
        "subCaptionTextAlign":      { "type": "string", "default": "" },
        "subCaptionColor":          { "type": "string", "default": "" },
        "subCaptionColorHover":     { "type": "string", "default": "" },

        "buttonPaddingTop":    { "type": "string", "default": "" },
        "buttonPaddingRight":  { "type": "string", "default": "" },
        "buttonPaddingBottom": { "type": "string", "default": "" },
        "buttonPaddingLeft":   { "type": "string", "default": "" },

        "buttonPaddingTopTablet":    { "type": "string", "default": "" },
        "buttonPaddingRightTablet":  { "type": "string", "default": "" },
        "buttonPaddingBottomTablet": { "type": "string", "default": "" },
        "buttonPaddingLeftTablet":   { "type": "string", "default": "" },
        "buttonPaddingTopMobile":    { "type": "string", "default": "" },
        "buttonPaddingRightMobile":  { "type": "string", "default": "" },
        "buttonPaddingBottomMobile": { "type": "string", "default": "" },
        "buttonPaddingLeftMobile":   { "type": "string", "default": "" }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "anchor": true,
        "align": ["wide", "full"]
    },
    "editorScript": "file:./index.js",
    "editorStyle":  "file:./editor.scss",
    "style":        "file:./style.scss",
    "render":       "file:./render.php"
}
