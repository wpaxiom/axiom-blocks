{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axiom-blocks/css-grid",
  "version": "1.0.0",
  "title": "CSS Grid",
  "category": "axiom-blocks",
  "description": "Build responsive unequal CSS Grid layouts with explicit item placement.",
  "keywords": ["grid", "layout", "columns", "responsive"],
  "textdomain": "axiom-blocks",
  "icon": "grid-view",
  "attributes": {
    "layoutMode": { "type": "string", "default": "equal" },
    "layoutModeTablet": { "type": "string", "default": "" },
    "layoutModeMobile": { "type": "string", "default": "" },
    "columns": { "type": "number", "default": 3 },
    "columnsTablet": { "type": "number" },
    "columnsMobile": { "type": "number" },
    "minColumnWidth": { "type": "string", "default": "240px" },
    "minColumnWidthTablet": { "type": "string", "default": "" },
    "minColumnWidthMobile": { "type": "string", "default": "" },
    "columnTemplate": { "type": "string", "default": "repeat(3, minmax(0, 1fr))" },
    "rowTemplate": { "type": "string", "default": "" },
    "autoColumns": { "type": "string", "default": "auto" },
    "autoRows": { "type": "string", "default": "auto" },
    "autoFlow": { "type": "string", "default": "row" },
    "dense": { "type": "boolean", "default": false },
    "justifyItems": { "type": "string", "default": "stretch" },
    "alignItems": { "type": "string", "default": "stretch" },
    "justifyContent": { "type": "string", "default": "normal" },
    "alignContent": { "type": "string", "default": "normal" },
    "columnGap": { "type": "string", "default": "24px" },
    "rowGap": { "type": "string", "default": "24px" },
    "backgroundColor": { "type": "string", "default": "" },
    "borderTopWidth": { "type": "string", "default": "" },
    "borderRightWidth": { "type": "string", "default": "" },
    "borderBottomWidth": { "type": "string", "default": "" },
    "borderLeftWidth": { "type": "string", "default": "" },
    "borderStyle": { "type": "string", "default": "" },
    "borderColor": { "type": "string", "default": "" },
    "radiusTopLeft": { "type": "string", "default": "" },
    "radiusTopRight": { "type": "string", "default": "" },
    "radiusBottomRight": { "type": "string", "default": "" },
    "radiusBottomLeft": { "type": "string", "default": "" },
    "gridShadow": { "type": "string", "default": "" },
    "paddingTop": { "type": "string", "default": "" },
    "paddingRight": { "type": "string", "default": "" },
    "paddingBottom": { "type": "string", "default": "" },
    "paddingLeft": { "type": "string", "default": "" },
    "marginTop": { "type": "string", "default": "" },
    "marginRight": { "type": "string", "default": "" },
    "marginBottom": { "type": "string", "default": "" },
    "marginLeft": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "align": ["wide", "full"], "anchor": true },
  "editorScript": "file:./index.js",
  "style": "file:./style.scss",
  "editorStyle": "file:./editor.scss"
}
