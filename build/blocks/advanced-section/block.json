{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axiom-blocks/advanced-section",
  "version": "1.0.0",
  "title": "Advanced Section",
  "category": "axiom-blocks",
  "description": "Full-width container with rich backgrounds, overlays and content layout controls.",
  "keywords": ["section", "container", "background", "hero", "cover"],
  "textdomain": "axiom-blocks",
  "icon": "cover-image",
  "attributes": {
    "backgroundType":       { "type": "string",  "default": "color" },
    "backgroundColor":      { "type": "string",  "default": "" },
    "gradientType":         { "type": "string",  "default": "linear" },
    "gradientAngle":        { "type": "number",  "default": 135 },
    "gradientFromColor":    { "type": "string",  "default": "#4f46e5" },
    "gradientToColor":      { "type": "string",  "default": "#ec4899" },
    "backgroundImage":      { "type": "object",  "default": null },
    "backgroundSize":       { "type": "string",  "default": "cover" },
    "backgroundPosition":   { "type": "string",  "default": "center center" },
    "backgroundRepeat":     { "type": "string",  "default": "no-repeat" },
    "backgroundAttachment": { "type": "string",  "default": "scroll" },
    "enableParallax":       { "type": "boolean", "default": false },
    "parallaxSpeed":        { "type": "number",  "default": 30 },
    "gradientUseMidStop":   { "type": "boolean", "default": false },
    "gradientMidColor":     { "type": "string",  "default": "#9333ea" },
    "gradientFromStop":     { "type": "number",  "default": 0 },
    "gradientMidStop":      { "type": "number",  "default": 50 },
    "gradientToStop":       { "type": "number",  "default": 100 },

    "overlayType":              { "type": "string",  "default": "color" },
    "overlayColor":             { "type": "string",  "default": "" },
    "overlayGradientType":      { "type": "string",  "default": "linear" },
    "overlayGradientAngle":     { "type": "number",  "default": 180 },
    "overlayGradientFromColor": { "type": "string",  "default": "#000000" },
    "overlayGradientToColor":   { "type": "string",  "default": "rgba(0,0,0,0)" },
    "overlayOpacity":           { "type": "number",  "default": 0 },
    "overlayBlendMode":         { "type": "string",  "default": "normal" },

    "minHeight":            { "type": "string",  "default": "400px" },
    "minHeightTablet":      { "type": "string",  "default": "" },
    "minHeightMobile":      { "type": "string",  "default": "" },
    "mobileMinHeight":      { "type": "string",  "default": "" },
    "verticalAlign":        { "type": "string",  "default": "center" },
    "horizontalAlign":      { "type": "string",  "default": "center" },
    "align":                { "type": "string",  "default": "" },

    "borderStyle":  { "type": "string", "default": "none" },
    "borderWidth":  { "type": "number", "default": 0 },
    "borderColor":  { "type": "string", "default": "#000000" },
    "borderRadius": { "type": "number", "default": 0 },

    "paddingTop":    { "type": "string", "default": "" },
    "paddingRight":  { "type": "string", "default": "" },
    "paddingBottom": { "type": "string", "default": "" },
    "paddingLeft":   { "type": "string", "default": "" },
    "marginTop":     { "type": "string", "default": "" },
    "marginRight":   { "type": "string", "default": "" },
    "marginBottom":  { "type": "string", "default": "" },
    "marginLeft":    { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "layout": {
      "default": { "type": "constrained" }
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "viewScript": "file:./assets/parallax.js",
  "render": "file:./render.php"
}
