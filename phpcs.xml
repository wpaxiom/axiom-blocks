<?xml version="1.0"?>
<ruleset name="AxiomBlocks Coding Standards">
    <description>AxiomBlocks WordPress Coding Standards</description>

    <!-- What to scan (PHP files only) -->
    <file>axiom-blocks.php</file>
    <dir>src</dir>

    <!-- Only scan PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Exclude paths -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Exclude specific rules that may conflict with modern PHP -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- PHP Compatibility -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Minimum PHP version -->
    <config name="testVersion" value="7.4-"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Show sniff codes -->
    <arg value="s"/>

    <!-- Report format -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <!-- Encoding -->
    <config name="encoding" value="utf-8"/>

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>
</ruleset>
